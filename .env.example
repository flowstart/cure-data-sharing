# 应用设置
APP_NAME="数据安全共享系统"
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY="your_secret_key_here"
HOST="0.0.0.0"
PORT=8000

# 数据库设置
DATABASE_URL="sqlite:///./secure_data_sharing.db"
# 如果使用PostgreSQL
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/secure_data_sharing"

# 密码学设置
MASTER_KEY_PATH="./keys/master_key"
PUBLIC_KEY_PATH="./keys/public_key"

# 区块链设置
ETHEREUM_NODE_URL="http://localhost:8545"
ETHEREUM_PRIVATE_KEY=""
DATA_REGISTRY_CONTRACT_ADDRESS=""
ATTRIBUTE_AUTHORITY_CONTRACT_ADDRESS=""

# IPFS设置
IPFS_API_URL="http://localhost:5001"
IPFS_GATEWAY_URL="http://localhost:8080"

# JWT设置
JWT_SECRET_KEY="your_jwt_secret_key_here"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# 日志设置
LOG_LEVEL="INFO"
LOG_FILE="logs/app.log"